{
  "name": "@formiva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "scan-worker": "tsx src/scan-worker.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx test/smoke-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@clerk/backend": "^3.23.1",
    "@formiva/config": "workspace:*",
    "@formiva/contracts": "workspace:*",
    "@formiva/crypto": "workspace:*",
    "@formiva/db": "workspace:^",
    "@formiva/observability": "workspace:*",
    "fastify": "^5.4.0",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0"
  }
}
